# .gitignore — ignore private images and documents
# Recommended: place private files in a dedicated folder and ignore that folder.
# Example: put sensitive files under `assets/private/` and keep them out of the public repo.
/assets/private/

# If you use a different folder, add it here (examples):
# /private/
# /secrets/

# Optional: ignore common image types globally (only enable if you never commit images)
# *.png
# *.jpg
# *.jpeg
# *.gif
# *.webp
# *.svg
# *.psd
# *.ai

# Optional: ignore common document types
# *.pdf
# *.docx
# *.doc
# *.xls
# *.xlsx
# *.ppt
# *.pptx
# *.odt
# *.txt

# OS junk
.DS_Store
Thumbs.db
